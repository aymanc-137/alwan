<footer class="store-footer mt-20  mx-auto">
			{% set is_email = theme.settings.get('enable_email_subscription', false) %}
{% if theme.settings.get('enable_footer_wavey', false) %}

    <div class="store-footer__wave absolute left-0 -top-16 w-full overflow-hidden leading-none pointer-events-none" aria-hidden="true">
        <svg 
		
		style="fill: {{ theme.settings.get('footer_color', '#60a5fa') }}"
		class="relative block w-full h-16" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 80" preserveAspectRatio="none">
 		    <path d="M0 40C120 20 240 0 360 10C480 20 600 60 720 70C840 80 960 60 1080 40C1200 20 1320 0 1440 10" fill="none" stroke="black" stroke-width="2"/>
 		    <path d="M0 80V40C120 20 240 0 360 10C480 20 600 60 720 70C840 80 960 60 1080 40C1200 20 1320 0 1440 10V80H0Z" fill="currentColor" />
        </svg>
    </div>

	{% endif %}


	<div aria-label="footer" 
		 style="
		 {{theme.settings.get('footer_background_image') ? 'background-image: url(' ~ theme.settings.get('footer_background_image') ~ ');' : ''}}
		 
		 background-color: {{ theme.settings.get('footer_color', '#60a5fa') }}"

	 class="    store-footer__inner {{theme.settings.get('enable_footer_wavey', false) ? '' : 'border-t-2'}}  text-gray-100   bg-center bg-no-repeat">
		
		<div class="container mx-auto grid grid-col-1 lg:grid-cols-5 gap-8 ">

			{% if not is_email %}
			<div class="">
			</div>
			{% endif %}
		
		{# <div class="container grid grid-col-1 lg:grid-cols-6 gap-8 lg:gap-6"> #}

			<div class=" ">
				
				<a href="{{ link('/') }}" class="flex flex-col items-center ">
					<img src="{{ store.logo }}" alt="{{ store.name }}" class="w-32" />
 				  </a>
				{% if store.description %}
					<p class="max-w-xs leading-6 mb-6">
						{{ store.description|raw }}
					</p>
				{% endif %}

				<div class="hidden lg:block">
					<salla-social class="mb-6"></salla-social>
				</div>

				{% if store.settings.is_multilingual or store.settings.currencies_enabled %}
				<button type="button" onclick="salla.event.dispatch('localization::open')" class="btn--rounded-gray basis-0">
					<span class="flag iti__flag iti__{{ user.language.country_code }} rounded-sm"></span>
					<span class="mx-1.5">|</span> <span>{{ currency.symbol }}</span>
				</button>
				{% endif %}
          {# vat #}
          {% if store.settings.tax.number %}
            <div class="flex rtl:space-x-reverse space-x-2 items-end">
              {% if store.settings.tax.certificate %}
                <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" alt="{{ store.settings.tax.number }}">
                  <img width="100%" height="100%" src="{{ 'images/s-empty.png' | cdn }}" data-src="{{'images/tax.png' | cdn(70,70)}}" class="lazy w-10 rounded-sm hover:opacity-80 transition-opacity" alt="value added tax">
                </a>
              {% endif %}
              <div>
                <p class="text-sm text-text-grey mb-1">{{ trans('common.elements.tax_number') }}</p>
                <b class="text-sm">{{ store.settings.tax.number }}</b>
              </div>
            </div>

            {% if store.settings.tax.certificate %}
              <salla-modal sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
                <div class="flex justify-center max-w-full">
                  <img class="w-full" loading="lazy" 
                  src="{{ 'images/s-empty.png' | cdn }}" 
                  data-src="{{ store.settings.tax.certificate }}" 
                  alt="{{ store.settings.tax.number }}"/>
                </div>
              </salla-modal>
            {% endif %}
          {% endif %}
        </div>

			<div>
				<h3>{{ trans('blocks.footer.pages_links') }}</h3>
				<salla-menu source="footer"></salla-menu>
			</div>

			<div>
				<salla-contacts></salla-contacts>

				<div class="lg:hidden contact-social">
					<salla-social></salla-social>
				</div>
			</div>
		
			{% set email_url = theme.settings.get('email_subscription_url', "") %}
			{% if is_email %}

			<div class=" ">
				<h3 class="text-3xl font-bold mb-2">
					
					{{ theme.settings.get('mail_list_title','تابعنا عبر البريد الإلكتروني') }}
				</h3>
				<p class=" mb-4 dark:text-slate-200">
					{{ theme.settings.get('mail_list_subtitle','احصل على آخر الأخبار والتحديثات مباشرة إلى بريدك الإلكتروني.') }}
				
				</p>
				
				<div class="main-bg p-1 rounded-xl flex items-center">
					<input
						type="email"
						name="{{theme.settings.get('email_input_filed')}}"
						placeholder="أدخل بريدك الإلكتروني"
						class="w-full px-2 py-2 rounded-xl focus:outline-none text-gray-900 neo-shadow" 
					/>
					<input type="hidden" name="u" value="{{theme.settings.get('user_id_email')}}">
					<input type="hidden" name="id"  value="{{theme.settings.get('audience_id_email')}}">
					<button
							type="submit"
							name="subscribe"
							class="neo-shadow hover:bg-gray-700 mx-2 px-2 py-2 rounded-xl text-white font-semibold"
						>
							{{ trans('blocks.footer.Subscribe') }}
					</button>
				</div>
			</div>
			{% endif %}
			
 						<salla-apps-icons class="mx-auto"  apps-title="{{ trans('blocks.footer.apps_title') }}" vertical="true" ></salla-apps-icons>

 		
		</div>
	</div>

	<div class="md:flex items-center justify-between py-4 container text-center">
		<span class="text-sm copyright-text">{% hook copyright %}</span>
		<salla-payments></salla-payments>
	</div>

</div>

<span class="hidden bottom-2 rtl:pl-24 ltr:pr-24 md:grid-cols-3 opacity-40"></span></footer>

	<salla-modal has-skeleton="true" position="top" class="rounded-md" id="search-modal-naqaa">
		<h4>{{ trans('blocks.footer.search') }}</h4>
		<hr>
		<div class="m-3 flex-1 md:h-10 h-96">
		  <salla-search inline oval height="36"></salla-search>
	  </div>
	 </salla-modal>
	 <salla-localization-modal></salla-localization-modal>