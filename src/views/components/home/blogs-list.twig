
<section class="w-full py-10 {{ component.enable_border ? 'border-t border-b border-black' : '' }}"

{% if component.enable_backgroud %}

      {% if component.background_image %}
        style="background-color: {{ component.background_color | default('#ffffff') }}; background-image: linear-gradient(rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.5)), url('{{ component.background_image }}'); background-repeat: repeat;"
      {% else %}
        style="background-color: {{ component.background_color | default('#ffffff') }};"
      {% endif %}

{% endif %}

>
     {% if component.title %}
 
              <div
                            style="text-shadow: .5px .5px .5px rgba(0, 0, 0, 0.5);"

              class="w-96 mx-auto mb-5 font-[{{component.title_font | default('BackToSchool')}}] in-view in-view--bounce-up">
              {% if component.title_style %}
              {% include 'pages.partials.product.styledtitle' with {componentdata: component} %}
              {% else %}
              <h1 class="text-5xl mx-auto mb-5 text-center">{{component.title}}</h1>
              {% endif %}
              </div>
     {% endif %}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-4 md:w-5/6 w-[90%] mx-auto">

        {% for blog in component.blogs %}
        <a
        href="{{blog.url}}"
        class="relative w-full h-80 rounded-lg border border-black neo-shadow overflow-hidden bg-cover bg-center in-view in-view--bounce-up"
        style="--in-view-delay: {{ loop.index0 * 120 }}ms"
       >
       <img src="{{blog.thumbnail}}" width="800" height="320" class="w-full h-1/2 object-cover hover:scale-105  transition-all duration-300" alt="{{ blog.title }}" loading="lazy" decoding="async">
        <!-- Dark Gradient Overlay at the Bottom -->
                 <!-- Content Container -->
                <div class="absolute  border-t border-black  bottom-0 h-1/2 bg-white w-full p-4 text-black ">
                <h2 class="text-2xl font-bold mb-2">{{blog.title}}</h2>
                <p class="text-sm mb-4">{{blog.promotion_title}}</p>
                <div class="flex justify-between text-xs">
                    <span>{{blog.author.created_at}}</span>
                    <span>{{blog.author.name}}</span>
                </div>
                </div>
            </a>
    
        {% endfor %} 

    </div>
  </section>