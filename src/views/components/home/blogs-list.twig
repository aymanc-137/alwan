
     {% if component.title %}
 
              <div class="w-96 mx-auto mb-5">
              {% include 'pages.partials.product.styledtitle' with {componentdata: component} %}
              </div>
     {% endif %}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-4 md:w-5/6 w-[90%] mx-auto">

        {% for blog in component.blogs %}
        <a
        href="{{blog.url}}"
        class="relative w-full hover:scale-105 h-80 hover:shadow-2xl transition-all duration-300 hover:shadow-white rounded-lg overflow-hidden bg-cover bg-center shadow-xl"
        style="background-image: url({{blog.thumbnail }});">
        <!-- Dark Gradient Overlay at the Bottom -->
        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                <!-- Content Container -->
                <div class="absolute bottom-0 w-full p-4 text-white">
                <h2 class="text-2xl font-bold mb-2">{{blog.title}}</h2>
                <p class="text-sm mb-4">{{blog.promotion_title}}</p>
                <div class="flex justify-between text-xs">
                    <span>{{blog.author.created_at}}</span>
                    <span>{{blog.author.name}}</span>
                </div>
                </div>
            </a>
    
        {% endfor %} 

    </div>
  