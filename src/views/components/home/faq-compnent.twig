{% if component.faq is not empty %}
<section

{% if component.enable_backgroud %}

      {% if component.background_image %}
        style="background-color: {{ component.background_color | default('#ffffff') }}; background-image: linear-gradient(rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.5)), url('{{ component.background_image }}'); background-repeat: repeat;"
      {% else %}
        style="background-color: {{ component.background_color | default('#ffffff') }};"
      {% endif %}

{% endif %} 


 class="py-10 lg:py-16 {{ component.enable_borders ? 'border-y border-black' : '' }}">
    <div class="container mx-auto px-4">
        {# Section title #}
        {# {{ trans('blocks.home.testimonials') }} #}
        {% if component.title %}
            {% if component.title_style %}
            <div      style="text-shadow: .5px .5px .5px rgba(0, 0, 0, 0.5);"
                     class="w-80 mb-5 mx-auto font-[{{component.title_font | default('BackToSchool')}}]">
            {% include 'pages.partials.product.styledtitle' with {componentdata: component} %}
 
            </div>
            {% else %}
            <h2                style="text-shadow: .5px .5px .5px rgba(0, 0, 0, 0.5);"
class="text-2xl md:text-3xl font-bold text-center mb-10">{{ component.title }}</h2>
            {% endif %}
        {% endif %}

        {# Prepare two columns by splitting the collection in the middle #}
        {% set total = component.faq|length %}
        {% set half  = (total / 2)|round(0, 'ceil') %}
        {% set col1  = component.faq|slice(0, half) %}
        {% set col2  = component.faq|slice(half) %}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {# Render each column #}
            {% for column in [col1, col2] %}
                <div class="space-y-4 ">
                    {% for item in column %}
                        <details class="group neo-shadow rounded-md overflow-hidden bg-white">
                            <summary class="flex justify-between items-center cursor-pointer py-3 px-4 list-none">
                                <span class="font-medium">{{ item.question }}</span>
                                <svg class="w-4 h-4 text-gray-600 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                                </svg>
                            </summary>
                            <div class="px-4 py-3 text-sm text-gray-600 bg-gray-50">
                                {{ item.answer }}
                            </div>
                        </details>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}