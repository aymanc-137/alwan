

{% if component.faq is not empty %}
<style>
.faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 0 1rem;
}

.faq-answer.open {
    max-height: 500px;
    padding: 0.75rem 1rem;
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.faq-arrow {
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.faq-arrow.rotated {
    transform: rotate(180deg);
}

.faq-question {
    transition: background-color 0.3s ease;
}

.faq-question:hover {
    background-color: rgba(0, 0, 0, 0.02);
}
</style>

<section
{% if component.enable_backgroud %}
      {% if component.background_image %}
        style="background-color: {{ component.background_color | default('#ffffff') }}; background-image: linear-gradient(rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.5)), url('{{ component.background_image }}'); background-repeat: repeat;"
      {% else %}
        style="background-color: {{ component.background_color | default('#ffffff') }};"
      {% endif %}
{% endif %} 
 class="py-20 lg:py-16 faq-component {{ component.enable_borders ? 'border-y border-black' : '' }}">
    <div class="container mx-auto px-4">
        {# Section title #}
        {% if component.title %}
            {% if component.title_style %}
            <div style="text-shadow: .5px .5px .5px rgba(0, 0, 0, 0.5);"
                 class="w-80 mb-5 mx-auto font-[{{component.title_font | default('BackToSchool')}}]">
            {% include 'pages.partials.product.styledtitle' with {componentdata: component} %}
            </div>
            {% else %}
            <h2 style="text-shadow: .5px .5px .5px rgba(0, 0, 0, 0.5);"
                class="text-2xl md:text-3xl font-bold text-center mb-10">{{ component.title }}</h2>
            {% endif %}
        {% endif %}

        {# Prepare two columns by splitting the collection in the middle #}
        {% set total = component.faq|length %}
        {% set half  = (total / 2)|round(0, 'ceil') %}
        {% set col1  = component.faq|slice(0, half) %}
        {% set col2  = component.faq|slice(half) %}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {# Render each column #}
            {% for column in [col1, col2] %}
                <div class="space-y-4">
                    {% for item in column %}
                        <div class="neo-shadow rounded-md overflow-hidden bg-white">
                            <div class="faq-question flex justify-between items-center cursor-pointer py-3 px-4" 
                                 onclick="toggleFAQ(this)">
                                <span class="font-medium">{{ item.question }}</span>
                                <svg class="faq-arrow w-4 h-4 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                                </svg>
                            </div>
                            <div class="faq-answer text-sm text-gray-600 bg-gray-50">
                                {{ item.answer }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<script>
function toggleFAQ(element) {
    const answer = element.nextElementSibling;
    const arrow = element.querySelector('.faq-arrow');
    
    // Close all other open FAQs (optional - remove this section if you want multiple open)
    /*
    document.querySelectorAll('.faq-answer.open').forEach(openAnswer => {
        if (openAnswer !== answer) {
            openAnswer.classList.remove('open');
            openAnswer.previousElementSibling.querySelector('.faq-arrow').classList.remove('rotated');
        }
    });
    */
    
    // Toggle current FAQ
    answer.classList.toggle('open');
    arrow.classList.toggle('rotated');
}
</script>
{% endif %}