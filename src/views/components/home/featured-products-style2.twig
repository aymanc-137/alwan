{#
| Variable                      | Type      | Description                                                         |
|-------------------------------|-----------|---------------------------------------------------------------------|
| items                         | array     | shared variable in all layout, index.twig, and all components views |
| items[].title                 | string    | Section title                                                       |
| items[].name                  | string    | Alias for title                                                     |
| items[].type                  | string    | category,most_sales,latest_products,chosen_products                 |
| items[].featured_product      | Product   |                                                                     |
| items[].special_product.id    | string    | Product string id                                                   |
| items[].special_product.title | string    | Product Name                                                        |
| items[].products[]            | Product[] |                                                                     |
| items[].limit                 | Int       | Number of products to be shown                                      |
| items[].id                    | String    | Section id                                                          |
| postion                       | int       | Sorting number starts from zero                                     |
| is_slider                     | Bool      | Products should be movable or static                                |
#}
{% set component_id='featured-products-style2-' ~ position %}
{% set is_vertical = theme.settings.get('vertical_fixed_products', true) %}
{# background-gradient: linear-gradient(180deg, #, url('https://cdn.lamsaweb.com/cdnAlwan/toys-seamless-pattern.png')) #}

{% set enable_sections_backgroud = theme.settings.get('enable_section_backgroud',false)%}
{% set enable_sections_border = theme.settings.get('enable_sections_border',false)%}
{% set background_sections_color = theme.settings.get('background_sections_color','#ffffff')%}
{% set background_sections_image = theme.settings.get('background_sections_image')%}

<section
id="{{ component_id }}"

  class="border-y border-black  s-block-tabs s-block--tabs-produtcs s-block--full-bg {{ is_slider ? 'as-slider':'as-grid' }}  py-8 sm:py-16
 

 {{ enable_sections_border ? 'border-y border-black' : '' }}"

          {% if enable_sections_backgroud %}

                {% if background_sections_image %}
                  style="background-color: {{ background_sections_color | default('#ffffff') }}; background-image: linear-gradient(rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.5)), url('{{ background_sections_image }}'); background-repeat: repeat;"
                {% else %}
                  style="background-color: {{ background_sections_color | default('#ffffff') }};"
                {% endif %}

          {% endif %}
          >
  
  <div class="container">

      <div class="tabs hide-scroll">
          {% for section in items %}
              <salla-button 
                class="tab-trigger {{ loop.first?'is-active':'' }}"
                data-target="{{ component_id }}-{{ section.id }}"
                data-component-id="{{ component_id }}"
                fill="outline">
                  {{ section.title }}
              </salla-button>
          {% endfor %}
      </div>

      <div class="tabs-wrapper">
        {% for section in items %}
            <div id="{{ component_id }}-{{ section.id }}" class="tabs__item {{ loop.first?'is-active':'' }}">
                {% if is_slider %}
                    <salla-products-slider 
                      slider-id="section-{{ section.id }}-slider" 
                      source="selected" 
                      source-value="[{{ section.products|map((product) => product.id)|join(',') }}]" 
                      >
                    </salla-products-slider>
                {% else %}
                    <salla-products-list  
                      source="selected" 
                      source-value="[{{ section.products|map((product) => product.id)|join(',') }}]"
                      {{is_vertical ? '' : 'horizontal-cards'}}
                      >
                    </salla-products-list>
                {% endif %}
            </div>
        {% endfor %}
      </div>
  </div>
</section> 
