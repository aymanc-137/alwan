<div class="flex justify-evenly mx-auto w-5/6 my-20">
{% for item in component.theme_features %}
<div class="bg-[#EBFFFF] relative  rounded-[70%/50%] border-2 border-black w-80 h-80 ">

        <div class="rounded-full border-2 border-black bg-purple-400 mx-auto w-24 h-24 -mt-5 absolute top-0 left-1/2 transform -translate-x-1/2 z-10">
                  
                    <script type="module" src="https://cdn.jsdelivr.net/npm/@dotlottie/player-component@latest/dist/dotlottie-player.mjs"></script>

                  {% if item.is_animated %}
                      <dotlottie-player src="{{ item.url }}" autoplay loop style="width:80px;height:80px"></dotlottie-player>
                  {% else %}
                      <img src="{{ item.image }}" alt="{{ item.title }}" style="width:80px;height:80px" />
                  {% endif %}
        
        </div>
          <div class=" relative overflow-hidden rounded-[70%/50%] w-full h-full">
          <div class="place-self-center border  flex flex-col gap-2" >
          <h2>{{ item.title }}</h2>
            <p>{{ item.description }}</p>
          </div>
              <div class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-bl from-sky-300 to-transparent opacity-50 rounded-bl-full"></div>
              <div class="absolute bottom-0 left-0 w-40 h-40 bg-gradient-to-bl from-[#ffca1c] to-transparent opacity-50 rounded-tr-full"></div>
          </div>

</div>
{% endfor %}
 
</div>
