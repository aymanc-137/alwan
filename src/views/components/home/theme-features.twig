   

<section 
   class="w-full py-20 {{ component.enable_border ? 'border-y border-black' : '' }}"

   {% if component.enable_backgroud %}

        {% if component.background_image %}
            style="background-color: {{ component.background_color | default('#ffffff') }}; background-image: linear-gradient(rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.5)), url('{{ component.background_image }}'); background-repeat: repeat;"
            {% else %}
            style="background-color: {{ component.background_color | default('#ffffff') }};"
        {% endif %}

   {% endif %} 
   
   >
   
   {% if component.title %}
        <div 
                      style="text-shadow: .5px .5px .5px rgba(0, 0, 0, 0.5);"

         class="text-center my-5 mx-auto">

                {% if component.title_style %}

                <div class="w-72 font-[{{component.title_font | default('BackToSchool')}}] sm:w-80 md:w-96 mx-auto mb-5 in-view in-view--bounce-up">
                    {% include 'pages.partials.product.styledtitle' with {componentdata: component} %}
                </div>
                {% else %}
                <h1 class="text-5xl font-[{{component.title_font | default('BackToSchool')}}] mx-auto mb-5 text-center in-view in-view--bounce-up">{{component.title | default('لماذا يختارنا الجميع؟') }}</h1>
                {% endif %}
                <p class="text-center text-xl in-view in-view--bounce-up" style="--in-view-delay: 150ms">{{ component.sub_title | default('لأننا نقدم أكثر من مجرد ألعاب – نقدم تجربة مليئة بالثقة، الجودة، والمتعة!') }}</p>
        </div>
    {% endif %}


<div class="grid grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 max-w-7xl mx-auto px-4 my-10 md:my-20">
{% for item in component.theme_features %}

<style>
    .bg-item-\[\{{ item.background_color | default('#EBFFFF') }}\] {
        background-color: {{ item.background_color | default('#EBFFFF') }};
    }
    .bg-item-\[\{{ item.icon_color | default('#C971C2') }}\] {
        background-color: {{ item.icon_color | default('#C971C2') }};
    }
</style>

<div class="bg-item-[{{ item.background_color | default('#EBFFFF') }}] relative rounded-[70%/50%] border-2 border-black w-full aspect-square max-w-[180px] sm:max-w-[220px] md:max-w-[260px] lg:max-w-xs mx-auto in-view in-view--bounce-up" style="--in-view-delay: {{ loop.index0 * 120 }}ms">

            <div class="rounded-full border-2 border-black bg-item-[{{ item.icon_color | default('#C971C2') }}] mx-auto w-16 h-16 sm:w-20 sm:h-20 md:w-24 md:h-24 -mt-8 md:-mt-10 absolute top-0 left-1/2 transform -translate-x-1/2 z-10 flex items-center justify-center">

                            {% if item.is_animated %}
                                <dotlottie-player src="{{ item.url }}" autoplay loop style="width:85%;height:85%"></dotlottie-player>
                            {% else %}
                                <img src="{{ item.image }}" alt="{{ item.title }}" width="80" height="80" class="w-[85%] h-[85%] object-contain" loading="lazy" decoding="async" />
                            {% endif %}
            
            </div>

          <div class="relative overflow-hidden rounded-[70%/50%] w-full h-full">
              <div class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-bl from-sky-300 to-black rounded-bl-full -z-1"></div>
                <div class="absolute bottom-0 left-0 w-40 h-40 bg-gradient-to-bl from-[#ffca1c] to-transparent opacity-50 rounded-tr-full -z-10"></div>
                    <div class="place-self-center w-5/6 mx-auto mt-10 sm:mt-16 md:mt-20 flex flex-col gap-1 md:gap-2 z-10 text-center" >
                    <h2 class="text-base sm:text-lg md:text-xl font-bold">{{ item.title }}</h2>
                    <p class="text-xs sm:text-sm md:text-base">{{ item.text }}</p>
              </div>
          </div>
          

</div>
{% endfor %}
 
</div>
</section>
<script defer type="module" src="https://cdn.jsdelivr.net/npm/@dotlottie/player-component@latest/dist/dotlottie-player.mjs"></script>
