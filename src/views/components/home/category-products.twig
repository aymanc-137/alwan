<section class="{{ component.enable_border ? 'border-y border-black' : '' }}"

                            {% if component.enable_backgroud %}

                                    {% if component.background_image %}
                                        style="background-color: {{ component.background_color | default('#ffffff') }}; background-image: linear-gradient(rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.5)), url('{{ component.background_image }}'); background-repeat: repeat;"
                                        {% else %}
                                        style="background-color: {{ component.background_color | default('#ffffff') }};"
                                    {% endif %}

                            {% endif %} 
                    >
<div class="p-5 my-16  md:w-[90%] w-[98%] mx-auto neo-shadow md:-skew-x-3" style="background-color: {{ component.product_backgroud_color | default('#91edff') }}; text-shadow: .5px .5px .5px rgba(0, 0, 0, 0.5);">
    {% if component.title_style %}
<div class=" font-[{{component.title_font | default('BackToSchool')}}] ">
    {% include 'pages.partials.product.styledtitle' with {componentdata: component , class: 'w-72 mx-auto -mt-16 '} %}
</div>
    
    {% else %}
    <h1 class="text-5xl mx-auto font-[{{component.title_font | default('BackToSchool')}}] mb-2 text-center">{{component.title | default('لماذا يختارنا الجميع؟') }}</h1>
    {% endif %}
    <div class="flex flex-col md:flex-row md:skew-x-3">

                <div class="w-full md:w-[10%] z-10 ">

                        <a href="{{ component.product_url }}" class="mt-6 md:-mr-8 neo-shadow transition-all duration-200 {{ marginClass }} z-1 md:h-[35rem] h-[25rem] min-h-44 md:w-60 w-[95%] md:mx-8 bg-center border-4-harir flex justify-center relative overflow-hidden md:-skew-x-6 ">

                            {# Conditional background: Video or Image #}
                            {% if component.is_video and component.video_url %}

                                {# Video Background #}
                                <video autoplay muted loop playsinline class="absolute z-1 w-full h-full object-cover lazy">
                                    <source
                                    src="{{ component.video_url }}" type="video/mp4">
                                    {# Fallback image if video doesn't load #}
                                    <img src="{{ component.background }}" alt="Fallback image" class="absolute z-0 w-full h-full object-cover">
                                </video>
                            {% else %}

                                {# Image Background #}
                                         <div class="absolute z-0 w-full h-full bg-cover bg-center bg-no-repeat" style="background-image: url('{{ component.background }}');"></div>

                            
                            {% endif %}

                          
                        </a>
                    
                </div>

                <div class="md:-z-10 my-auto justify-center w-full md:w-[90%] p-3 ">
                    <salla-products-slider autoplay source="selected" source-value="[{{ component.products|map((product) => product.id)|join(',') }}]"></salla-products-slider>
                </div>

        
    </div>

</div>
</section>
