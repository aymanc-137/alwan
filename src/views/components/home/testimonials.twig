{#
| Variable           | Type                      | Description                         |
|--------------------|---------------------------|-------------------------------------|
| limit              | string                    | Maximum number of the testimonials  |
| type               | string                    | `default:store` all, product, store |
| sort               | string                    |                                     |
| hide_customer_info | bool                      | show/hide info customers            |
#}


<section class="s-block s-block--testimonials container overflow-hidden">





        {% set component = {title:trans('testimonials.title')} %}

                <div class=" my-5 flex flex-col items-center justify-center w-full" >
                    <div
                        style="text-shadow: .5px .5px .5px rgba(0, 0, 0, 0.5);"
                        class="w-96 mb-5 mx-auto in-view in-view--bounce-up">

                        {% include 'pages.partials.product.styledtitle' with {componentdata: component} %}
                    </div>

                    <a href="{{ page('testimonials')}}" class="text-center my-3 hover:underline hover:text-primary mx-auto text-lg lg:text-lg text-slate-600 in-view in-view--bounce-up" style="--in-view-delay: 150ms">
                        {{trans('testimonials.show_all')}}
                    </a>                                            
                </div>










    <salla-reviews class="in-view in-view--bounce-up" style="--in-view-delay: 250ms" {{ display_all_url ? "display-all-link" : "" }} limit="{{ limit }}" sort="{{ sort }}" {{ hide_customer_info ? 'hide-customer-info' : '' }} type="{{type}}"></salla-reviews>
</section> 
