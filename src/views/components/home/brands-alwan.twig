<section>
       <div class="shape-container">
        <div class="primary-side">
           <div class="w-[60%] mx-auto -translate-x-1/2 translate-y-1/2  ">
                <p class="grid grid-cols-4  gap-4 mx-10">
                {% for brand in component.brands %}

                <a href="{{brand.url}}" class="hover:scale-110 transition-all duration-300">

                        <img src="{{brand.logo}}" width="100" height="100"  alt="{{brand.name}}">
                
                </a>
                {% endfor %}
                
                </p>

            </div>         
            </div>
        <div class="stroke-divider">
            <!-- This element is just for the stroke, no content needed -->
        </div>
        <div class="secondary-side">
              <div class="w-[80%] mx-auto translate-x-20 translate-y-1/2 justify-center  ">
            <h2>{{component.title}}</h2>
            <p class="text-lg w-1/2 ">{{component.subtitle}}</p>
         </div>

        </div>
    </div>
     <style>
       

        .shape-container {
            width: 100%;
             aspect-ratio: 2000 / 800;
            position: relative;
            /* No background on container, as child elements will provide it */
        }

        .primary-side,
        .stroke-divider,
        .secondary-side {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            box-sizing: border-box; /* Important for padding */
            overflow: hidden; /* Clips content to the shape */
        }

        .primary-side {
            background-color: #FCFFEC; /* Light yellow */
            z-index: 1;
            padding: 20px; /* Example padding for content */
        }

        .stroke-divider {
            background-color: black; /* Stroke color */
            z-index: 2;
            /* No padding needed for stroke element */
        }

        .secondary-side {
            background-color: #7ACBCB; /* Teal */
            z-index: 3;
            padding: 20px; /* Example padding for content */
        }

        /* --- Common CSS Variables --- */
        :root { /* Or on .shape-container if preferred */
            --stroke-half-width: 1px; /* Total stroke will be 2px */

            /* --- Default: Horizontal Zig-Zag (Mobile) --- */
            --hz-peak-y: 45%;
            --hz-valley-y: 55%;

            /* --- Desktop: Vertical Zig-Zag X-positions (Defined in media query) --- */
            /* --vz-peak-x: 35%; */
            /* --vz-valley-x: 40%; */
        }

        /* --- Default: HORIZONTAL LAYOUT (Mobile) --- */

        /* Primary Side (Top Part) */
        .primary-side {
            clip-path: polygon(
                0% 0%, /* top-left */
                100% 0%, /* top-right */
                100% calc(var(--hz-peak-y) - var(--stroke-half-width)),
                87.5% calc(var(--hz-valley-y) - var(--stroke-half-width)),
                75% calc(var(--hz-peak-y) - var(--stroke-half-width)),
                62.5% calc(var(--hz-valley-y) - var(--stroke-half-width)),
                50% calc(var(--hz-peak-y) - var(--stroke-half-width)),
                37.5% calc(var(--hz-valley-y) - var(--stroke-half-width)),
                25% calc(var(--hz-peak-y) - var(--stroke-half-width)),
                12.5% calc(var(--hz-valley-y) - var(--stroke-half-width)),
                0% calc(var(--hz-peak-y) - var(--stroke-half-width))
            );
        }

        /* Stroke Divider */
        .stroke-divider {
            clip-path: polygon(
                /* Top edge of the stroke */
                0%     calc(var(--hz-peak-y) - var(--stroke-half-width)),
                12.5%  calc(var(--hz-valley-y) - var(--stroke-half-width)),
                25%    calc(var(--hz-peak-y) - var(--stroke-half-width)),
                37.5%  calc(var(--hz-valley-y) - var(--stroke-half-width)),
                50%    calc(var(--hz-peak-y) - var(--stroke-half-width)),
                62.5%  calc(var(--hz-valley-y) - var(--stroke-half-width)),
                75%    calc(var(--hz-peak-y) - var(--stroke-half-width)),
                87.5%  calc(var(--hz-valley-y) - var(--stroke-half-width)),
                100%   calc(var(--hz-peak-y) - var(--stroke-half-width)),
                /* Bottom edge of the stroke (traced in reverse X) */
                100%   calc(var(--hz-peak-y) + var(--stroke-half-width)),
                87.5%  calc(var(--hz-valley-y) + var(--stroke-half-width)),
                75%    calc(var(--hz-peak-y) + var(--stroke-half-width)),
                62.5%  calc(var(--hz-valley-y) + var(--stroke-half-width)),
                50%    calc(var(--hz-peak-y) + var(--stroke-half-width)),
                37.5%  calc(var(--hz-valley-y) + var(--stroke-half-width)),
                25%    calc(var(--hz-peak-y) + var(--stroke-half-width)),
                12.5%  calc(var(--hz-valley-y) + var(--stroke-half-width)),
                0%     calc(var(--hz-peak-y) + var(--stroke-half-width))
            );
        }

        /* Secondary Side (Bottom Part) */
        .secondary-side {
            clip-path: polygon(
                /* Top zig-zag edge of the teal area */
                0%     calc(var(--hz-peak-y) + var(--stroke-half-width)),
                12.5%  calc(var(--hz-valley-y) + var(--stroke-half-width)),
                25%    calc(var(--hz-peak-y) + var(--stroke-half-width)),
                37.5%  calc(var(--hz-valley-y) + var(--stroke-half-width)),
                50%    calc(var(--hz-peak-y) + var(--stroke-half-width)),
                62.5%  calc(var(--hz-valley-y) + var(--stroke-half-width)),
                75%    calc(var(--hz-peak-y) + var(--stroke-half-width)),
                87.5%  calc(var(--hz-valley-y) + var(--stroke-half-width)),
                100%   calc(var(--hz-peak-y) + var(--stroke-half-width)),
                /* Fill the rest of the bottom part */
                100% 100%, /* Bottom-right corner */
                0% 100%    /* Bottom-left corner */
            );
        }

        /* --- Styles for Larger Screens (e.g., tablets and desktops) --- */
        @media (min-width: 768px) {
            :root { /* Or on .shape-container */
                 /* Override/define vertical zig-zag variables */
                --vz-peak-x: 55%;
                --vz-valley-x: 58%;
            }

            /* Primary Side (Left Part) */
            .primary-side {
                clip-path: polygon(
                    0% 0%, /* top-left */
                    calc(var(--vz-peak-x) - var(--stroke-half-width)) 0%,
                    calc(var(--vz-valley-x) - var(--stroke-half-width)) 12.5%,
                    calc(var(--vz-peak-x) - var(--stroke-half-width)) 25%,
                    calc(var(--vz-valley-x) - var(--stroke-half-width)) 37.5%,
                    calc(var(--vz-peak-x) - var(--stroke-half-width)) 50%,
                    calc(var(--vz-valley-x) - var(--stroke-half-width)) 62.5%,
                    calc(var(--vz-peak-x) - var(--stroke-half-width)) 75%,
                    calc(var(--vz-valley-x) - var(--stroke-half-width)) 87.5%,
                    calc(var(--vz-peak-x) - var(--stroke-half-width)) 100%,
                    0% 100% /* bottom-left */
                );
            }

            /* Stroke Divider */
            .stroke-divider {
                clip-path: polygon(
                    /* Outer (left) edge of the stroke */
                    calc(var(--vz-peak-x) - var(--stroke-half-width)) 0%,
                    calc(var(--vz-valley-x) - var(--stroke-half-width)) 12.5%,
                    calc(var(--vz-peak-x) - var(--stroke-half-width)) 25%,
                    calc(var(--vz-valley-x) - var(--stroke-half-width)) 37.5%,
                    calc(var(--vz-peak-x) - var(--stroke-half-width)) 50%,
                    calc(var(--vz-valley-x) - var(--stroke-half-width)) 62.5%,
                    calc(var(--vz-peak-x) - var(--stroke-half-width)) 75%,
                    calc(var(--vz-valley-x) - var(--stroke-half-width)) 87.5%,
                    calc(var(--vz-peak-x) - var(--stroke-half-width)) 100%,
                    /* Inner (right) edge of the stroke (traced in reverse Y) */
                    calc(var(--vz-peak-x) + var(--stroke-half-width)) 100%,
                    calc(var(--vz-valley-x) + var(--stroke-half-width)) 87.5%,
                    calc(var(--vz-peak-x) + var(--stroke-half-width)) 75%,
                    calc(var(--vz-valley-x) + var(--stroke-half-width)) 62.5%,
                    calc(var(--vz-peak-x) + var(--stroke-half-width)) 50%,
                    calc(var(--vz-valley-x) + var(--stroke-half-width)) 37.5%,
                    calc(var(--vz-peak-x) + var(--stroke-half-width)) 25%,
                    calc(var(--vz-valley-x) + var(--stroke-half-width)) 12.5%,
                    calc(var(--vz-peak-x) + var(--stroke-half-width)) 0%
                );
            }

            /* Secondary Side (Right Part) */
            .secondary-side {
                clip-path: polygon(
                    /* Left zig-zag edge of the teal area */
                    calc(var(--vz-peak-x) + var(--stroke-half-width)) 0%,
                    calc(var(--vz-valley-x) + var(--stroke-half-width)) 12.5%,
                    calc(var(--vz-peak-x) + var(--stroke-half-width)) 25%,
                    calc(var(--vz-valley-x) + var(--stroke-half-width)) 37.5%,
                    calc(var(--vz-peak-x) + var(--stroke-half-width)) 50%,
                    calc(var(--vz-valley-x) + var(--stroke-half-width)) 62.5%,
                    calc(var(--vz-peak-x) + var(--stroke-half-width)) 75%,
                    calc(var(--vz-valley-x) + var(--stroke-half-width)) 87.5%,
                    calc(var(--vz-peak-x) + var(--stroke-half-width)) 100%,
                    /* Fill the rest of the right part */
                    100% 100%, /* Bottom-right corner */
                    100% 0%    /* Top-right corner */
                );
            }
        }

        /* Example content styling */
        .primary-side h2, .secondary-side h2 {
            margin-top: 0;
            font-size: 1.5em; /* Adjust based on container size */
        }
        .primary-side p, .secondary-side p {
            font-size: 1em; /* Adjust based on container size */
            line-height: 1.4;
        }

        /* For very small screens, you might want to adjust padding or font sizes further */
        @media (max-width: 400px) {
            .primary-side, .secondary-side {
                padding: 10px;
            }
            .primary-side h2, .secondary-side h2 {
                font-size: 1.2em;
            }
            .primary-side p, .secondary-side p {
                font-size: 0.9em;
            }
        }

    </style>
</section>