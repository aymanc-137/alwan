{% set enable_sections_backgroud = theme.settings.get('enable_sections_backgroud',false)%}
{% set enable_sections_border = theme.settings.get('enable_sections_border',false)%}
{% set background_sections_color = theme.settings.get('background_sections_color','#ffffff')%}
{% set background_sections_image = theme.settings.get('background_sections_image')%}
<section class="s-block s-block--testimonials s-block--custom-testimonials container {{ enable_sections_border ? 'border-y border-black' : '' }}"

          {% if enable_sections_backgroud %}

                {% if background_sections_image %}
                  style="background-color: {{ background_sections_color | default('#ffffff') }}; background-image: linear-gradient(rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.5)), url('{{ background_sections_image }}'); background-repeat: repeat;"
                {% else %}
                  style="background-color: {{ background_sections_color | default('#ffffff') }};"
                {% endif %}

          {% endif %}
          >

    <div>
        <div class="flex hidden justify-between">
            <h1 class="mb-4 mr-2 text-lg font-bold leading-[1.2]">{{ trans('blocks.home.testimonials') }}</h1>
        </div>
                 <div class="w-96 mb-5 mx-auto">
                 {% set object = {'title': trans('blocks.home.testimonials')} %}
                    {% include 'pages.partials.product.styledtitle' with {componentdata: object} %}

            </div>
        <salla-slider 
          centered
          slides-per-view="1"
          type="testimonials" 
          class="testimonials-slider" 
          centered
          controls-outer
          auto-play
          id="custom-testimonials-{{ position }}-slider">
            <div slot="items">
                {% for index, item in component.items %}
                    <div class="swiper-slide p-10">
                        <div class="neo-shadow flex justify-between  relative bg-white rounded-xl p-6 sm:p-8 max-w-md sm:max-w-lg w-full">
                            <!-- Profile Image: Absolutely Positioned -->
                                <img
                                src="{{ 'images/s-empty.png' | asset }}" data-src="{{ item.avatar }}"      
                                alt="{{ item.name|trim ? item.name : 'testimonial-' ~ index }}"
                                class="lazy border-2 border-black absolute -top-10 -right-10 sm:-top-12 sm:-right-12 w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover shadow-md"
                                style="transform: translateY(50%);"
                            />

                            <!-- Using style for transform because Tailwind's translate-x-1/2 might not be exactly what's needed when combined with RTL absolute positioning -->
                            <div class="flex mr-5 place-self-end   justify-between items-end mb-4">
                                <!-- Quotation Marks -->
 
                                <!-- Reviewer Info -->
                                <div class="text-right ml-auto mr-4"> 

                                    <h3 class="text-lg sm:text-xl font-semibold text-gray-800">{{ item.name }}</h3>
                                    <div class="flex mt-1">
                                        <!-- Stars -->
                                            <salla-rating-stars size="small"
                                                                    value="{{ item.stars }}"></salla-rating-stars>
                                                                        <!-- Add a fifth empty star if needed, e.g., for a 4/5 rating -->
                                        <!-- <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gray-300" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg> -->
                                    </div>
                                </div>
                            </div>
                            <!-- Review Text -->
                            <p class="text-xl place-self-center    sm:text-2xl text-gray-700 font-medium text-center mt-6 sm:mt-8">
                            {{ item.text }}
                            </p>

                            <img class="w-8 -mt-6 -ml-5 place-self-start   "
                                style="transform: translateY(10%);" src="https://cdn.lamsaweb.com/cdnAlwan/quote-close-svgrepo-com.svg" alt="">
                        </div>
                        
                    </div>            
                {% endfor %} 
            </div>
        </salla-slider>
    </div> 
</section> 
