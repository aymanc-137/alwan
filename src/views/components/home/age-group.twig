<section >
    <div class="container">
 
     <!-- SVG Definitions -->
    <svg class="svg-defs" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <clipPath id="myCustomClipPath" clipPathUnits="objectBoundingBox">
                <!-- 
                    Coordinates are from 0 to 1 (0,0 is top-left, 1,1 is bottom-right).
                    M = moveto
                    Q = quadratic Bezier curve (controlX controlY, endX endY)
                    C = cubic Bezier curve (control1X control1Y, control2X control2Y, endX endY)
                    L = lineto
                    Z = closepath
                    This path creates a wavy, organic shape.
                -->
                <path d="M0.05,0.15 
                         Q0.2,0.02 0.4,0.1 
                         C0.5,0.03 0.7,0.03 0.8,0.1 
                         Q0.95,0.05 0.95,0.25 
                         C0.98,0.4 0.98,0.6 0.93,0.75 
                         Q0.9,0.95 0.75,0.92 
                         C0.65,0.98 0.45,0.98 0.3,0.9 
                         Q0.1,0.95 0.05,0.8 
                         C0.01,0.65 0.01,0.4 0.05,0.15 Z" />
            </clipPath>
        </defs>
    </svg>

    <!-- The content container that will be clipped -->
    <div class="content-container">
        <div class="text-bubble" dir="rtl">
            من عمر 5 الى 10 سنيين
        </div>
        <!-- You can add more content here if needed, though it might be covered by the background image -->
    </div>

    </div>
</section>