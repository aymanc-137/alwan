{% include 'pages.partials.component-default-dump' with { '_dump_path': 'home.map' } %}

{% set locations = component.locations|default([]) %}
{% set title = component.title|default('') %}

{% if locations %}
<section class="s-block bg-white w-5/6 mx-auto rounded-2xl border border-black p-3 my-8" id="store-locations-{{ position }}">
 
        {% if component.title %}
            {% if component.style_title %}
            <div 
            
                          style="text-shadow: .5px .5px .5px rgba(0, 0, 0, 0.5);"

             class="w-96 mb-5 mx-auto font-[{{component.title_font | default('BackToSchool')}}]">
               {% include 'pages.partials.product.styledtitle' with {componentdata: component} %}
 
            </div>
            {% else %}
            <h2 class="text-2xl md:text-3xl font-bold text-center mb-10">{{ component.title }}</h2>
            {% endif %}
        {% endif %}

        
    {# Tabs for multiple locations #}
    {% if locations|length > 1 %}
    <div class="flex flex-wrap justify-center gap-2 mb-6">
        {% for loc in locations %}
            <button class="tab-button px-4 py-2 border-2 border-black rounded transition-all {{ loop.first ? 'bg-black text-white' : 'bg-white' }}" data-target="loc-{{ position }}-{{ loop.index0 }}">
                {{ loc.city }}
            </button>
        {% endfor %}
    </div>
    {% endif %}

    {# Location panes #}
    {% for loc in locations %}
        <div id="loc-{{ position }}-{{ loop.index0 }}" class="location-pane {{ locations|length > 1 and not loop.first ? 'hidden' : '' }}">
            <div class="grid md:grid-cols-2 gap-6 items-start">
                <div>
                    <h3 class="text-2xl font-bold mb-2">{{ loc.city }}</h3>
                    <p class="mb-2 whitespace-pre-wrap">{{ loc.address }}</p>
                    {% if loc.phone %}
                        <p class="mb-2"><span class="font-semibold">{{ trans('blocks.home.map.phone')|default('Phone') }}:</span> {{ loc.phone }}</p>
                    {% endif %}
                    {% if loc.hours %}
                        <p class="mb-2"><span class="font-semibold">{{ trans('blocks.home.map.hours')|default('Working Hours') }}:</span> {{ loc.hours }}</p>
                    {% endif %}
                </div>
                <div class="border-2 border-black rounded overflow-hidden h-72 w-full">
                    <iframe src="{{ loc.map_url }}" class="w-full h-full" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
        </div>
    {% endfor %}
</section>
{% endif %}

<script>
// Simple tabs behavior (isolated per component instance)
(function () {
    const container = document.getElementById('store-locations-{{ position }}');
    if (!container) return;
    const btns = container.querySelectorAll('.tab-button');
    btns.forEach(btn => {
        btn.addEventListener('click', () => {
            const targetId = btn.dataset.target;
            // Reset all buttons
            btns.forEach(b => {
                b.classList.remove('bg-black', 'text-white', 'bg-white');
                b.classList.add('bg-white', 'text-black');
            });
            // Activate current button
            btn.classList.remove('bg-white', 'text-black');
            btn.classList.add('bg-black', 'text-white');
            // Toggle panes
            container.querySelectorAll('.location-pane').forEach(pane => pane.classList.add('hidden'));
            const activePane = container.querySelector('#' + targetId);
            if (activePane) activePane.classList.remove('hidden');
        });
    });
})();
</script>